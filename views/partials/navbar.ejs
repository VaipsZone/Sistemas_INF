<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/menu">
            <img src="/images/Logo_no_bg.webp" alt="TastyApp" height="34">
            TastyApp
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                aria-controls="mainNavbar" aria-expanded="false" aria-label="Mostrar menú">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="/menu"><i class="bi bi-house me-1"></i>Inicio</a></li>
                <% if (currentUser?.role === 'administrativo') { %>
                    <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i class="bi bi-people me-1"></i>Usuarios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/admin/menores"><i class="bi bi-person-vcard me-1"></i>Menores</a></li>
                <% } %>
                <% if (currentUser?.role === 'encargado') { %>
                    <li class="nav-item"><a class="nav-link" href="/encargado/autorizaciones"><i class="bi bi-check2-square me-1"></i>Autorizaciones</a></li>
                <% } %>
                <% if (currentUser?.role === 'tutor') { %>
                    <li class="nav-item"><a class="nav-link" href="/tutor/dashboard"><i class="bi bi-person-check me-1"></i>Mis menores</a></li>
                <% } %>
            </ul>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small"><%= currentUser?.name || 'Usuario' %></span>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="logoutButton">
                    <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
                </button>
            </div>
        </div>
    </div>
</nav>
<script>
    document.getElementById('logoutButton')?.addEventListener('click', async () => {
        await fetch('/api/auth/sign-out', { method: 'POST' });
        window.location.href = '/login';
    });
</script>
