<!DOCTYPE html>
<html lang="es">
<head>
    <title>Menores - TastyApp</title>
    <%- include('../partials/head.ejs') -%>
    <style>
        .minors-dashboard { color: #212529; }
        .minors-dashboard .card { background-color: #fff; }
        .minors-dashboard .table { color: #212529; }
        .minors-dashboard .table thead th { color: #212529; background-color: #f8f9fa; }
        .minors-dashboard .table tbody td { color: #212529; vertical-align: middle; }
        .minors-dashboard .table tbody tr { background-color: #fff; }
    </style>
</head>
<body class="bg-light">
    <%- include('../partials/navbar.ejs') -%>
    <main class="container py-5 minors-dashboard">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h1 class="fw-bold mb-1">Menores registrados</h1>
                <p class="text-muted mb-0">Administración de familias y tutores</p>
                <span class="badge bg-primary mt-2"><%= menores.length %> registro<%= menores.length === 1 ? '' : 's' %></span>
            </div>
            <div class="d-flex gap-2">
                <a href="/admin/menores/nuevo" class="btn btn-primary">Registrar menor</a>
            </div>
        </div>
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Nombre</th><th>CURP</th><th>Fecha de nacimiento</th><th>Familia</th><th>ID</th><th>Estado</th><th></th></tr></thead>
                    <tbody>
                    <% if (!menores.length) { %>
                        <tr><td colspan="7" class="text-center py-5">
                            <i class="bi bi-person-vcard fs-1 text-secondary"></i>
                            <p class="text-dark fw-semibold mt-3 mb-1">Aún no hay menores registrados</p>
                            <p class="text-muted mb-0">Utiliza “Registrar menor” para agregar el primer registro.</p>
                        </td></tr>
                    <% } %>
                    <% menores.forEach((menor) => { %>
                        <tr>
                            <td><a href="/admin/menores/<%= menor.id %>"><%= menor.nombre %> <%= menor.apellido_pat %> <%= menor.apellido_mat %></a></td>
                            <td><%= menor.curp %></td><td><%= String(menor.fecha_nacimiento).slice(0, 10) %></td>
                            <td><%= menor.familia || 'Sin familia asignada' %></td>
                            <td>
                                <span class="badge <%= Number(menor.id_gratuito) === 1 ? 'bg-success text-white' : 'bg-warning text-dark' %>">
                                    <%= Number(menor.id_gratuito) === 1 ? 'Gratuito' : 'Con costo' %>
                                </span>
                            </td>
                            <td>
                                <span class="badge <%= Number(menor.activo) === 1 ? 'bg-primary text-white' : 'bg-secondary text-white' %>">
                                    <%= Number(menor.activo) === 1 ? 'Activo' : 'Inactivo' %>
                                </span>
                            </td>
                            <td><a class="btn btn-sm btn-outline-primary" href="/admin/menores/<%= menor.id %>/editar">Editar</a></td>
                        </tr>
                    <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
    <%- include('../partials/footer.ejs') -%>
</body>
</html>
